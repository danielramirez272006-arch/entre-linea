# ==============================================================================
# Entre Líneas — Diario Seguro
# Variables de entorno del servidor (NUNCA incluir secretos reales en este archivo)
# Copia este archivo como .env en la raíz del proyecto para desarrollo local.
# ==============================================================================

# Entorno y red
NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
# En producción con proxy inverso (nginx, etc.) usa 1; en local usa 0
TRUST_PROXY=0

# Base de datos PostgreSQL
DATABASE_URL=postgres://postgres:CAMBIA_ESTA_CONTRASENA@localhost:5432/entre_lineas
# Activa DB_SSL=true para bases gestionadas en la nube (Neon, Supabase, Render, Railway)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# Base de datos opcional para pruebas de integración reales
TEST_DATABASE_URL=postgres://postgres:CAMBIA_ESTA_CONTRASENA@localhost:5432/entre_lineas_test
DB_QUERY_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=5000

# Sesiones (cookie HttpOnly, SameSite=Lax, Secure en producción)
SESSION_COOKIE_NAME=el_sid
SESSION_TTL_HOURS=24
SESSION_ABSOLUTE_TTL_HOURS=168

# Cifrado AES-256-GCM con versionado de llaves
# Genera una llave de 32 bytes en hexadecimal (64 caracteres hex):
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_ACTIVE_KEY_VERSION=v1
# Formato JSON de llaves por versión: {"v1":"<64-hex>"}
# Al rotar, agrega v2 y cambia ENCRYPTION_ACTIVE_KEY_VERSION=v2 manteniendo v1
# hasta re-cifrar todos los registros con: npm run keys:rotate
ENCRYPTION_KEYS_JSON={"v1":"REEMPLAZAR_CON_64_CARACTERES_HEXADECIMALES_ALEATORIOS"}

# Recuperación de contraseña y entrega de correo
PASSWORD_RESET_TTL_MINUTES=15
# Modo de correo: "local" (guarda archivos en DEV_MAIL_DIR) o "https-api"
MAIL_DRIVER=local
DEV_MAIL_DIR=backend/.dev-mail
# Opcional para uso posterior con proveedor HTTPS de correo
MAIL_API_URL=
MAIL_API_KEY=
MAIL_FROM=no-responder@entre-lineas.local

# Límites de seguridad y alertas
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=120
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_BASE_SECONDS=60
ALERT_FAILED_LOGINS_THRESHOLD=5

# Registro (logs JSON con Pino: trace, debug, info, warn, error, fatal, silent)
LOG_LEVEL=info
