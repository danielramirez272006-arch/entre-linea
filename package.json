{
  "name": "entre-lineas-diario-seguro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Entre Líneas — Diario Seguro: aplicación privada de diario personal con seguridad en profundidad.",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "node backend/scripts/dev.js",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "start": "npm run start --workspace=backend",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "admin:create": "npm run admin:create --workspace=backend",
    "keys:rotate": "npm run keys:rotate --workspace=backend",
    "test": "npm run test --workspace=backend",
    "test:unit": "npm run test:unit --workspace=backend",
    "test:integration": "npm run test:integration --workspace=backend",
    "test:e2e": "node --test tests/e2e/smoke.e2e.test.js",
    "test:browser": "node --test tests/e2e/browser.e2e.test.js",
    "audit:check": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "playwright": "^1.65.1"
  }
}
